      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tollgate_requests_total{cache!=\"none\"}[$__rate_interval])) / clamp_min(sum(rate(tollgate_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
