{
  "name": "tollgate",
  "version": "0.1.0",
  "description": "OpenAI-compatible LLM gateway with routing, failover, caching, budgets and cost tracking",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "tsx mock-provider/main.ts",
    "demo": "tsx --env-file=config/demo.env src/index.ts",
    "consumer": "tsx consumer/main.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "validate:config": "tsx src/cli/validate-config.ts",
    "eval": "tsx evals/run.ts",
    "eval:gate": "tsx evals/gate.ts",
    "eval:ci": "tsx evals/ci.ts && tsx evals/gate.ts --results evals/results/golden.json",
    "eval:semantic": "tsx evals/semantic/tune.ts",
    "bench": "tsx loadtest/bench.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "autocannon": "^9.0.0",
    "eslint": "^9.39.5",
    "openai": "^7.55.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
