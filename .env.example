PORT=8080
LOG_LEVEL=info
TOLLGATE_CONFIG=config/tollgate.yaml

# Required to use the admin API (min 16 chars). Leave unset to disable /admin.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Convenience key for local development only. Unset in any shared environment.
TOLLGATE_DEV_KEY=tg_dev_local_key

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional backing services. Without them the gateway runs fully in memory.
REDIS_URL=redis://localhost:6379
# Semantic cache vector search needs RediSearch (Redis Stack or Redis 8).
# Set this when REDIS_URL points at a Redis without it, e.g. Memorystore.
REDIS_VECTOR_URL=
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=llm.usage

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tollgate
